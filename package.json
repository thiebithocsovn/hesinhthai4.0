{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run test:smart-timetable && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:static": "vite build",
    "build:wall-api": "esbuild server/wallApiServer.ts --bundle --platform=node --format=cjs --packages=external --outfile=api-dist/server.cjs",
    "start:wall-api": "node api-dist/server.cjs",
    "deploy:wall-api": "python3 scripts/deploy-wall-api.py",
    "test:wall-api": "node --import tsx scripts/test-wall-api-server.ts && python3 scripts/test-wall-deployment.py",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:firestore": "eslint firestore.rules",
    "deploy:firestore": "npx --yes firebase-tools@^15.17.0 deploy --only firestore:rules --project gen-lang-client-0870957273 --non-interactive",
    "test:gestureclass": "node scripts/test-gestureclass.cjs",
    "test:catalog": "node --import tsx scripts/test-application-catalog.ts",
    "test:question-engine": "node --import tsx scripts/test-question-engine.ts",
    "test:question-pptx": "node --import tsx scripts/test-question-pptx-export.ts",
    "test:question-exam-bridge": "node --import tsx scripts/test-question-exam-bridge.ts",
    "test:platform": "node --import tsx scripts/test-platform.ts",
    "test:auth-flow": "node --import tsx scripts/test-auth-flow.ts",
    "test:teacher-password": "node --import tsx scripts/test-teacher-password.ts && node --import tsx scripts/test-teacher-password-serverless.ts && node scripts/test-teacher-password-native.cjs && python3 scripts/test-teacher-password-deployment.py",
    "test:teacher-password-ui": "node scripts/test-teacher-password-ui.cjs",
    "test:head-shake": "node --import tsx scripts/test-head-shake-questions.ts",
    "test:student-portal": "node --import tsx scripts/test-exam-student-portal.ts && npm run test:teacher-printing",
    "test:kpi-analytics": "node --import tsx scripts/test-kpi-analytics.ts",
    "test:kpi-rules": "node --import tsx scripts/test-kpi-rules.ts",
    "test:exam-access-rules": "node --import tsx scripts/test-exam-access-rules.ts",
    "test:exam-privacy": "node --import tsx scripts/test-exam-privacy.ts",
    "test:ai-services": "node --import tsx scripts/test-ai-services.ts",
    "test:firebase-ai-diagnostics": "node --import tsx scripts/test-firebase-ai-diagnostics.ts",
    "test:platform-metrics": "node --import tsx scripts/test-platform-metrics.ts",
    "test:scalability": "node --import tsx scripts/test-scalability.ts",
    "test:teacher-isolation": "node --import tsx scripts/test-teacher-isolation.ts",
    "test:hardening": "node --import tsx scripts/test-ecosystem-hardening.ts",
    "test:security-hardening": "node --import tsx scripts/test-security-hardening.ts",
    "test:plicker": "node --import tsx scripts/test-plicker.ts",
    "test:pwa": "node --import tsx scripts/test-pwa.ts",
    "test:pdf": "node --import tsx scripts/test-pdf-tools.ts",
    "test:plicker-live": "node --import tsx scripts/test-plicker-live.ts",
    "test:plicker-mobile": "node --import tsx scripts/test-plicker-mobile.ts",
    "test:plicker-display": "node --import tsx scripts/test-plicker-display.ts",
    "test:plicker-import": "node --import tsx scripts/test-plicker-question-import.ts",
    "test:plicker-editor": "node --import tsx scripts/test-plicker-question-editor.ts",
    "test:plicker-fraction": "node --import tsx scripts/test-plicker-fraction.ts",
    "test:plicker-student-sync": "node --import tsx scripts/test-plicker-student-sync.ts",
    "test:plicker-reports": "node --import tsx scripts/test-plicker-reports.ts",
    "test:smart-timetable": "node --import tsx scripts/test-smart-timetable.ts",
    "test:learning-wall": "node --import tsx scripts/test-learning-wall.ts",
    "test:wall-assessment": "node --import tsx scripts/test-wall-assessment.ts",
    "test:wall-chat": "node --import tsx scripts/test-wall-chat.ts",
    "test:wall-openai": "node --import tsx scripts/test-wall-openai.ts",
    "test:wall-providers": "node --import tsx scripts/test-wall-providers.ts",
    "test:wall-assessment-ui": "node scripts/test-wall-assessment-ui.cjs",
    "test:learning-wall-rules": "node scripts/test-learning-wall-rules.mjs",
    "deploy:learning-wall": "npx --yes firebase-tools@^15.17.0 deploy --config firebase.learning-wall-production.json --only firestore:rules --project gen-lang-client-0870957273 --non-interactive",
    "test:exam-receipt": "node --import tsx scripts/test-exam-receipt.ts",
    "test:exam-manual-grading": "node --import tsx scripts/test-exam-manual-grading.ts",
    "test:exam-result-deletion": "node --import tsx scripts/test-exam-result-deletion.ts",
    "test:exam-class-receipts": "node --import tsx scripts/test-exam-class-receipts.ts",
    "test:practical-file-check": "node --import tsx scripts/test-practical-file-check.ts",
    "test:teacher-printing": "node --import tsx scripts/test-teacher-exam-printing.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-image": "^3.22.0",
    "@tiptap/extension-subscript": "^3.22.0",
    "@tiptap/extension-superscript": "^3.22.0",
    "@tiptap/extension-table": "^3.22.0",
    "@tiptap/extension-table-cell": "^3.22.0",
    "@tiptap/extension-table-header": "^3.22.0",
    "@tiptap/extension-table-row": "^3.22.0",
    "@tiptap/extension-text-align": "^3.22.0",
    "@tiptap/extension-underline": "^3.22.0",
    "@tiptap/extension-youtube": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "@vercel/oidc": "^4.0.5",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-quill": "^2.0.0",
    "sanitize-html": "^2.18.1",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "playwright": "1.61.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
