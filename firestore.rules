rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (emailVerified() && request.auth.token.email == 'tuyenthcskimhy@gmail.com') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isActiveTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.id == request.auth.uid &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.status == 'active';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function ownsField(data, ownerField) {
      return ownerField in data && isActiveTeacher() && isOwner(data[ownerField]);
    }

    function mayAccess(data, ownerField) {
      return isAdmin() || ownsField(data, ownerField);
    }

    function ownerRemainsUnchanged(ownerField) {
      return ownerField in existing() && ownerField in incoming() &&
        existing()[ownerField] == incoming()[ownerField];
    }

    function wallPostOwnerIsConsistent() {
      return !('teacherId' in incoming()) || incoming().teacherId == incoming().authorId;
    }

    function categoryOwnerIsConsistent() {
      return !('ownerUid' in incoming()) || incoming().ownerUid == incoming().authorId;
    }

    function timetableWorkspaceIsSafe(teacherId) {
      return incoming().keys().hasAll(['teacherId', 'workspace', 'updatedAt']) &&
        incoming().keys().hasOnly(['teacherId', 'workspace', 'updatedAt']) &&
        incoming().teacherId == teacherId && isValidId(teacherId) &&
        incoming().workspace is map &&
        incoming().workspace.keys().hasAll(['scenario', 'solution', 'versions']) &&
        incoming().workspace.keys().hasOnly(['scenario', 'solution', 'versions']) &&
        incoming().workspace.scenario is map &&
        incoming().workspace.versions is list &&
        incoming().workspace.versions.size() <= 2 &&
        incoming().updatedAt is timestamp;
    }

    function isProtectedExamIdentifier(identifier) {
      return identifier is string && identifier.matches('^[a-f0-9]{64}$');
    }

    function publicScheduleIsSafe(scheduleId) {
      return isProtectedExamIdentifier(scheduleId) &&
        incoming().keys().hasAll([
          'id', 'teacherId', 'title', 'durationMinutes', 'questionCount', 'status', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'id', 'teacherId', 'title', 'durationMinutes', 'questionCount', 'status', 'createdAt', 'startTime'
        ]) &&
        incoming().id == scheduleId &&
        isValidId(incoming().teacherId) &&
        incoming().title is string && incoming().title.size() <= 240 &&
        incoming().durationMinutes is int && incoming().durationMinutes > 0 &&
        incoming().questionCount is int && incoming().questionCount >= 0 &&
        incoming().status == 'published';
    }

    function encryptedExamAccessIsSafe(accessId) {
      return isProtectedExamIdentifier(accessId) &&
        incoming().keys().hasAll([
          'teacherId', 'examId', 'status', 'version', 'iterations', 'salt', 'iv', 'ciphertext', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'teacherId', 'examId', 'status', 'version', 'iterations', 'salt', 'iv', 'ciphertext', 'updatedAt'
        ]) &&
        isValidId(incoming().teacherId) && isValidId(incoming().examId) &&
        incoming().status == 'published' && incoming().version == 1 &&
        incoming().iterations is int && incoming().iterations >= 100000 &&
        incoming().iterations <= 500000 &&
        incoming().salt is string && incoming().iv is string &&
        incoming().ciphertext is string && incoming().ciphertext.size() > 0;
    }

    function enrolledStudentBelongsToTeacher(studentId, teacherId) {
      return isValidId(studentId) && isValidId(teacherId) &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.teacherId == teacherId;
    }

    function examQuestionCountMatches(examId, questionCount) {
      return get(/databases/$(database)/documents/exams/$(examId)).data.questions is list &&
        get(/databases/$(database)/documents/exams/$(examId)).data.questions.size() == questionCount;
    }

    function activeSessionBelongsToStudent(sessionId, studentId, examId, teacherId) {
      return exists(/databases/$(database)/documents/exam_sessions/$(sessionId)) &&
        get(/databases/$(database)/documents/exam_sessions/$(sessionId)).data.status == 'taking' &&
        get(/databases/$(database)/documents/exam_sessions/$(sessionId)).data.studentId == studentId &&
        get(/databases/$(database)/documents/exam_sessions/$(sessionId)).data.examId == examId &&
        get(/databases/$(database)/documents/exam_sessions/$(sessionId)).data.teacherId == teacherId;
    }

    function guestStudentIsSafe(studentId) {
      return incoming().keys().hasAll(['id', 'teacherId', 'name', 'code', 'examId']) &&
        incoming().keys().hasOnly(['id', 'teacherId', 'name', 'code', 'examId']) &&
        incoming().id == studentId && isValidId(studentId) &&
        isValidId(incoming().teacherId) && isValidId(incoming().examId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 160 &&
        incoming().code is string && incoming().code.matches('^[0-9]{6}$');
    }

    function guestResultIsSafe(resultId) {
      return incoming().keys().hasAll([
          'id', 'examId', 'studentId', 'score', 'totalQuestions', 'submittedAt',
          'answers', 'cheatEvents', 'examVersion', 'teacherId'
        ]) &&
        incoming().keys().hasOnly([
          'id', 'examId', 'studentId', 'score', 'totalQuestions', 'submittedAt',
          'answers', 'cheatEvents', 'examVersion', 'teacherId'
        ]) &&
        incoming().id == resultId &&
        isValidId(incoming().examId) && isValidId(incoming().studentId) &&
        isValidId(incoming().teacherId) &&
        incoming().score is int && incoming().score >= 0 &&
        incoming().totalQuestions is int && incoming().totalQuestions > 0 &&
        incoming().totalQuestions <= 500 &&
        incoming().score <= incoming().totalQuestions &&
        incoming().submittedAt is string && incoming().submittedAt.size() <= 64 &&
        incoming().answers is map && incoming().cheatEvents is map &&
        incoming().examVersion is string && incoming().examVersion.size() <= 128 &&
        enrolledStudentBelongsToTeacher(incoming().studentId, incoming().teacherId) &&
        examQuestionCountMatches(incoming().examId, incoming().totalQuestions) &&
        activeSessionBelongsToStudent(resultId, incoming().studentId,
          incoming().examId, incoming().teacherId);
    }

    function guestSessionIsSafe(sessionId) {
      return incoming().keys().hasAll([
          'id', 'examId', 'studentId', 'startTime', 'lastActive', 'status', 'teacherId', 'examVersion'
        ]) &&
        incoming().keys().hasOnly([
          'id', 'examId', 'studentId', 'startTime', 'lastActive', 'status', 'teacherId', 'examVersion'
        ]) &&
        incoming().id == sessionId &&
        isValidId(incoming().examId) && isValidId(incoming().studentId) &&
        isValidId(incoming().teacherId) &&
        incoming().startTime is string && incoming().startTime.size() <= 64 &&
        incoming().lastActive is string && incoming().lastActive.size() <= 64 &&
        (incoming().status == 'taking' || incoming().status == 'submitted') &&
        incoming().examVersion is string && incoming().examVersion.size() <= 128 &&
        enrolledStudentBelongsToTeacher(incoming().studentId, incoming().teacherId);
    }

    function publicPlatformStatsAreSafe(statId, data) {
      return statId == 'overview' &&
        data.keys().hasAll([
          'registeredTeachers', 'activeTeachers', 'registeredSchools', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'registeredTeachers', 'activeTeachers', 'registeredSchools', 'updatedAt'
        ]) &&
        data.registeredTeachers is int && data.registeredTeachers >= 0 &&
        data.activeTeachers is int && data.activeTeachers >= 0 &&
        data.registeredSchools is int && data.registeredSchools >= 0 &&
        data.activeTeachers <= data.registeredTeachers &&
        data.registeredSchools <= data.registeredTeachers &&
        data.updatedAt is timestamp;
    }

    // Publication writes the exam and access payload together; validate their committed state.
    function publishedExamAfterWrite(examId, teacherId) {
      return isValidId(examId) && isValidId(teacherId) &&
        getAfter(/databases/$(database)/documents/exams/$(examId)).data.status == 'published' &&
        getAfter(/databases/$(database)/documents/exams/$(examId)).data.teacherId == teacherId;
    }

    function publishedExamBelongsToTeacher(examId, teacherId) {
      return isValidId(examId) && isValidId(teacherId) &&
        exists(/databases/$(database)/documents/exams/$(examId)) &&
        get(/databases/$(database)/documents/exams/$(examId)).data.status == 'published' &&
        get(/databases/$(database)/documents/exams/$(examId)).data.teacherId == teacherId;
    }

    match /teachers/{teacherId} {
      allow get: if isAdmin() || isOwner(teacherId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isOwner(teacherId) &&
        incoming().id == teacherId &&
        incoming().email == request.auth.token.email &&
        incoming().status == 'inactive' &&
        !('password' in incoming())
      );
      allow update, delete: if isAdmin();
    }

    match /timetable_workspaces/{teacherId} {
      allow get: if isAdmin() || (isActiveTeacher() && isOwner(teacherId));
      allow list: if isAdmin();
      allow create: if (isAdmin() || (isActiveTeacher() && isOwner(teacherId))) &&
        timetableWorkspaceIsSafe(teacherId);
      allow update: if (isAdmin() || (isActiveTeacher() && isOwner(teacherId))) &&
        ownerRemainsUnchanged('teacherId') && timetableWorkspaceIsSafe(teacherId);
      allow delete: if isAdmin() || (isActiveTeacher() && isOwner(teacherId));
    }

    match /categories/{categoryId} {
      allow read: if mayAccess(existing(), 'authorId');
      allow create: if isAdmin() || (
        ownsField(incoming(), 'authorId') && categoryOwnerIsConsistent()
      );
      allow update: if isAdmin() || (
        ownsField(existing(), 'authorId') && ownerRemainsUnchanged('authorId') &&
        categoryOwnerIsConsistent()
      );
      allow delete: if mayAccess(existing(), 'authorId');
    }

    match /wall_posts/{postId} {
      allow read: if mayAccess(existing(), 'authorId');
      allow create: if isAdmin() || (
        ownsField(incoming(), 'authorId') && wallPostOwnerIsConsistent()
      );
      allow update: if isAdmin() || (
        ownsField(existing(), 'authorId') &&
        ownerRemainsUnchanged('authorId') && wallPostOwnerIsConsistent()
      );
      allow delete: if mayAccess(existing(), 'authorId');
    }

    // Padlet-style boards publish an explicit projection. Private categories and
    // wall_posts retain their existing owner-only policies above.
    function sharedWall(shareId) {
      return get(/databases/$(database)/documents/shared_learning_walls/$(shareId)).data;
    }

    function sharedWallIsSafe(shareId) {
      let data = incoming();
      return shareId.matches('^[a-f0-9]{48}$') &&
        data.keys().hasAll(['authorId', 'title', 'description', 'icon', 'layout', 'background', 'sections', 'sectionIds', 'enabled', 'permission', 'updatedAt']) &&
        data.keys().hasOnly(['authorId', 'title', 'description', 'icon', 'layout', 'background', 'sections', 'sectionIds', 'enabled', 'permission', 'updatedAt']) &&
        isValidId(data.authorId) && data.title is string && data.title.size() > 0 && data.title.size() <= 180 &&
        data.description is string && data.description.size() <= 2000 && data.icon is string && data.icon.size() <= 32 &&
        data.layout in ['wall', 'grid', 'columns', 'stream', 'timeline', 'canvas', 'map'] &&
        data.background in ['sage', 'cream', 'blue', 'rose', 'lavender', 'white'] &&
        data.sections is list && data.sectionIds is list && data.sectionIds.size() > 0 && data.sectionIds.size() <= 40 &&
        data.sections.size() == data.sectionIds.size() &&
        isValidId(data.sectionIds[0]) &&
        get(/databases/$(database)/documents/categories/$(data.sectionIds[0])).data.authorId == data.authorId &&
        data.enabled is bool && data.permission in ['read', 'write'] && data.updatedAt == request.time;
    }

    function sharedWallCategoryIsSafe(shareId, categoryId) {
      return isValidId(categoryId) && categoryId in sharedWall(shareId).sectionIds &&
        get(/databases/$(database)/documents/categories/$(categoryId)).data.authorId == sharedWall(shareId).authorId &&
        (categoryId == sharedWall(shareId).sectionIds[0] || get(/databases/$(database)/documents/categories/$(categoryId)).data.parentId == sharedWall(shareId).sectionIds[0]);
    }

    function sharedWallPostIsSafe(shareId) {
      let data = incoming();
      return data.keys().hasAll(['categoryId', 'title', 'text', 'studentName', 'imageSrc', 'attachments', 'createdAt', 'color', 'pinned']) &&
        data.keys().hasOnly(['categoryId', 'title', 'text', 'studentName', 'imageSrc', 'attachments', 'createdAt', 'color', 'pinned', 'location', 'position']) &&
        sharedWallCategoryIsSafe(shareId, data.categoryId) && data.title is string && data.title.size() <= 200 &&
        data.text is string && data.text.size() <= 12000 &&
        data.studentName is string && data.studentName.size() <= 120 &&
        data.imageSrc is string && data.imageSrc.size() < 650000 &&
        data.attachments is list && data.attachments.size() <= 4 && data.createdAt is number &&
        data.color in ['#ffffff', '#fff3cc', '#e5f2e4', '#e5eefb', '#fbe5e8', '#efe6fc'] && data.pinned is bool;
    }

    function sharedWallAcceptsSubmissions(shareId) {
      let wall = sharedWall(shareId);
      let board = get(/databases/$(database)/documents/categories/$(wall.sectionIds[0])).data;
      return shareId.matches('^[a-f0-9]{48}$') && wall.enabled == true && wall.permission == 'write' &&
        (!('wallArchived' in board) || board.wallArchived == false);
    }

    // Student documents are inert downloads. Public callers never write approved posts.
    function wallSubmissionFileIsSafe(file) {
      return file is map &&
        file.keys().hasAll(['id', 'kind', 'name', 'url', 'size']) &&
        file.keys().hasOnly(['id', 'kind', 'name', 'url', 'size']) &&
        file.id is string && file.id.matches('^[A-Za-z0-9_-]{1,128}$') && file.kind == 'file' &&
        file.name is string && file.name.size() > 0 && file.name.size() <= 180 &&
        file.name.matches('(?i)^.+\\.(pdf|doc|docx|xls|xlsx|ppt|pptx|txt|csv|rtf|odt|ods|odp|zip|rar|7z|sb3)$') &&
        file.url is string && file.url.size() <= 436945 &&
        file.url.matches('^data:application/octet-stream;base64,[A-Za-z0-9+/]+={0,2}$') &&
        file.size is int && file.size > 0 && file.size <= 327680;
    }

    function wallSubmissionFilesAreSafe(data) {
      let files = 'attachments' in data ? data.attachments : [];
      return files is list && files.size() <= 2 &&
        (files.size() < 1 || wallSubmissionFileIsSafe(files[0])) &&
        (files.size() < 2 || wallSubmissionFileIsSafe(files[1])) &&
        data.imageSrc.size() + (files.size() > 0 ? files[0].url.size() : 0) +
          (files.size() > 1 ? files[1].url.size() : 0) <= 650000;
    }

    function wallSubmissionIsSafe(shareId, submissionId) {
      let data = incoming();
      // Public visitors can only create a submission while this board accepts work.
      // No Firebase account or anonymous-auth session is required.
      return isValidId(submissionId) && sharedWallAcceptsSubmissions(shareId) &&
        data.keys().hasAll(['title', 'text', 'studentName', 'categoryId', 'imageSrc', 'link', 'createdAt']) &&
        data.keys().hasOnly(['title', 'text', 'studentName', 'categoryId', 'imageSrc', 'link', 'attachments', 'createdAt']) &&
        wallSubmissionFilesAreSafe(data) &&
        data.title is string && data.title.size() <= 200 && data.text is string && data.text.size() <= 12000 &&
        data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 120 &&
        sharedWallCategoryIsSafe(shareId, data.categoryId) &&
        data.imageSrc is string && data.imageSrc.size() < 500000 &&
        (data.imageSrc == '' || data.imageSrc.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')) &&
        data.link is string && data.link.size() <= 2048 && (data.link == '' || data.link.matches('^https?://[^\\s]+$')) &&
        (data.title.size() > 0 || data.text.size() > 0 || data.imageSrc.size() > 0 || data.link.size() > 0 || ('attachments' in data && data.attachments.size() > 0)) &&
        data.createdAt == request.time;
    }

    match /shared_learning_walls/{shareId} {
      allow get: if mayAccess(existing(), 'authorId') ||
        (shareId.matches('^[a-f0-9]{48}$') && existing().enabled == true);
      allow list: if mayAccess(existing(), 'authorId');
      allow create: if mayAccess(incoming(), 'authorId') && sharedWallIsSafe(shareId);
      allow update: if mayAccess(existing(), 'authorId') && ownerRemainsUnchanged('authorId') && sharedWallIsSafe(shareId);
      allow delete: if mayAccess(existing(), 'authorId');

      match /posts/{postId} {
        allow read: if mayAccess(sharedWall(shareId), 'authorId') || sharedWall(shareId).enabled == true;
        allow create, update: if mayAccess(sharedWall(shareId), 'authorId') && sharedWallPostIsSafe(shareId);
        allow delete: if mayAccess(sharedWall(shareId), 'authorId');
      }
      match /submissions/{submissionId} {
        allow read, delete: if mayAccess(sharedWall(shareId), 'authorId');
        allow create: if wallSubmissionIsSafe(shareId, submissionId);
        allow update: if false;
      }
    }

    match /exams/{examId} {
      // Questions, answers, shuffled versions and roster lookup data are always private.
      allow read: if mayAccess(existing(), 'teacherId');
      allow create: if isAdmin() || ownsField(incoming(), 'teacherId');
      allow update: if isAdmin() || (
        ownsField(existing(), 'teacherId') && ownerRemainsUnchanged('teacherId')
      );
      allow delete: if mayAccess(existing(), 'teacherId');
    }

    match /public_exam_schedules/{scheduleId} {
      // Public notices contain metadata only: no exam code, questions, answers or roster.
      allow read: if existing().status == 'published';
      allow create: if (isAdmin() || ownsField(incoming(), 'teacherId')) &&
        publicScheduleIsSafe(scheduleId);
      allow update: if (isAdmin() || (
        ownsField(existing(), 'teacherId') && ownerRemainsUnchanged('teacherId')
      )) && publicScheduleIsSafe(scheduleId);
      allow delete: if mayAccess(existing(), 'teacherId');
    }

    match /public_exam_access/{accessId} {
      // Guests may request one encrypted payload only when they know its exam-code hash.
      allow get: if mayAccess(existing(), 'teacherId') ||
        (!isSignedIn() && existing().status == 'published' &&
          publishedExamBelongsToTeacher(existing().examId, existing().teacherId));
      allow list: if isAdmin();
      allow create: if (isAdmin() || ownsField(incoming(), 'teacherId')) &&
        encryptedExamAccessIsSafe(accessId) &&
        publishedExamAfterWrite(incoming().examId, incoming().teacherId);
      allow update: if (isAdmin() || (
        ownsField(existing(), 'teacherId') && ownerRemainsUnchanged('teacherId')
      )) && encryptedExamAccessIsSafe(accessId) &&
        publishedExamAfterWrite(incoming().examId, incoming().teacherId);
      allow delete: if mayAccess(existing(), 'teacherId');
    }

    match /classes/{classId} {
      allow read: if mayAccess(existing(), 'teacherId');
      allow create: if isAdmin() || ownsField(incoming(), 'teacherId');
      allow update: if isAdmin() || (
        ownsField(existing(), 'teacherId') && ownerRemainsUnchanged('teacherId')
      );
      allow delete: if mayAccess(existing(), 'teacherId');
    }

    match /students/{studentId} {
      // Student login uses an anonymized exam directory and never reads the class roster.
      allow read: if mayAccess(existing(), 'teacherId');
      allow create: if isAdmin() || ownsField(incoming(), 'teacherId') || (
        !isSignedIn() &&
        guestStudentIsSafe(studentId) &&
        publishedExamBelongsToTeacher(incoming().examId, incoming().teacherId)
      );
      allow update: if isAdmin() || (
        ownsField(existing(), 'teacherId') && ownerRemainsUnchanged('teacherId')
      );
      allow delete: if mayAccess(existing(), 'teacherId');
    }

    match /results/{resultId} {
      // Scores and reports are never readable by unauthenticated students.
      allow read: if mayAccess(existing(), 'teacherId');
      allow create: if isAdmin() || ownsField(incoming(), 'teacherId') || (
        !isSignedIn() &&
        guestResultIsSafe(resultId) &&
        resultId == incoming().studentId + '_' + incoming().examId &&
        publishedExamBelongsToTeacher(incoming().examId, incoming().teacherId)
      );
      allow update: if isAdmin() || (
        ownsField(existing(), 'teacherId') && ownerRemainsUnchanged('teacherId')
      );
      allow delete: if mayAccess(existing(), 'teacherId');
    }

    match /exam_sessions/{sessionId} {
      allow read: if mayAccess(existing(), 'teacherId');
      allow create: if isAdmin() || ownsField(incoming(), 'teacherId') || (
        !isSignedIn() &&
        guestSessionIsSafe(sessionId) &&
        incoming().status == 'taking' &&
        sessionId == incoming().studentId + '_' + incoming().examId &&
        publishedExamBelongsToTeacher(incoming().examId, incoming().teacherId)
      );
      allow update: if isAdmin() || (
        ownsField(existing(), 'teacherId') && ownerRemainsUnchanged('teacherId')
      ) || (
        !isSignedIn() &&
        ownerRemainsUnchanged('teacherId') &&
        guestSessionIsSafe(sessionId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lastActive', 'status']) &&
        existing().status == 'taking' &&
        sessionId == incoming().studentId + '_' + incoming().examId &&
        publishedExamBelongsToTeacher(incoming().examId, incoming().teacherId)
      );
      allow delete: if mayAccess(existing(), 'teacherId');
    }

    match /platform_stats/{statId} {
      // Public visitors may read one aggregate-only document; private profiles stay protected.
      allow get: if publicPlatformStatsAreSafe(statId, existing());
      allow list: if false;
      allow create, update: if isAdmin() && publicPlatformStatsAreSafe(statId, incoming());
      allow delete: if isAdmin();
    }
    // EduKPI AI: isolated school workspaces. A school identifier is not a credential.
    function kpiSchoolPath(schoolId) {
      return /databases/$(database)/documents/kpiSchools/$(schoolId);
    }
    function kpiMemberPath(schoolId, uid) {
      return /databases/$(database)/documents/kpiSchools/$(schoolId)/members/$(uid);
    }
    function kpiPeriodPath(schoolId, month) {
      return /databases/$(database)/documents/kpiSchools/$(schoolId)/periods/$(month);
    }
    function kpiOwner(schoolId) {
      return isSignedIn() && exists(kpiSchoolPath(schoolId)) &&
        get(kpiSchoolPath(schoolId)).data.ownerUid == request.auth.uid;
    }
    function kpiActiveMember(schoolId) {
      return isSignedIn() && exists(kpiMemberPath(schoolId, request.auth.uid)) &&
        get(kpiMemberPath(schoolId, request.auth.uid)).data.status == 'active';
    }
    function kpiCanAccess(schoolId) {
      return kpiOwner(schoolId) || kpiActiveMember(schoolId);
    }
    function kpiReviewer(schoolId) {
      return kpiOwner(schoolId) || (
        kpiActiveMember(schoolId) &&
        get(kpiMemberPath(schoolId, request.auth.uid)).data.role == 'reviewer'
      );
    }
    function kpiCriteriaSafe(criteria) {
      return criteria is list && criteria.size() == 6 &&
        criteria[0].keys().hasOnly(['key','label','max','group']) &&
        criteria[1].keys().hasOnly(['key','label','max','group']) &&
        criteria[2].keys().hasOnly(['key','label','max','group']) &&
        criteria[3].keys().hasOnly(['key','label','max','group']) &&
        criteria[4].keys().hasOnly(['key','label','max','group']) &&
        criteria[5].keys().hasOnly(['key','label','max','group']) &&
        criteria[0].key == 'ethics' && criteria[0].group == 'general' &&
        criteria[1].key == 'skills' && criteria[1].group == 'general' &&
        criteria[2].key == 'innovation' && criteria[2].group == 'general' &&
        criteria[3].key == 'quantity' && criteria[3].group == 'results' &&
        criteria[4].key == 'quality' && criteria[4].group == 'results' &&
        criteria[5].key == 'timeliness' && criteria[5].group == 'results' &&
        criteria[0].label is string && criteria[0].label.size() > 0 && criteria[0].label.size() <= 200 &&
        criteria[1].label is string && criteria[1].label.size() > 0 && criteria[1].label.size() <= 200 &&
        criteria[2].label is string && criteria[2].label.size() > 0 && criteria[2].label.size() <= 200 &&
        criteria[3].label is string && criteria[3].label.size() > 0 && criteria[3].label.size() <= 200 &&
        criteria[4].label is string && criteria[4].label.size() > 0 && criteria[4].label.size() <= 200 &&
        criteria[5].label is string && criteria[5].label.size() > 0 && criteria[5].label.size() <= 200 &&
        criteria[0].max is number && criteria[0].max >= 0 && criteria[0].max <= 100 &&
        criteria[1].max is number && criteria[1].max >= 0 && criteria[1].max <= 100 &&
        criteria[2].max is number && criteria[2].max >= 0 && criteria[2].max <= 100 &&
        criteria[3].max is number && criteria[3].max >= 0 && criteria[3].max <= 100 &&
        criteria[4].max is number && criteria[4].max >= 0 && criteria[4].max <= 100 &&
        criteria[5].max is number && criteria[5].max >= 0 && criteria[5].max <= 100 &&
        criteria[0].max + criteria[1].max + criteria[2].max +
        criteria[3].max + criteria[4].max + criteria[5].max == 100;
    }
    function kpiScoresSafe(scores, criteria) {
      return scores is map &&
        scores.keys().hasAll(['ethics','skills','innovation','quantity','quality','timeliness']) &&
        scores.keys().hasOnly(['ethics','skills','innovation','quantity','quality','timeliness']) &&
        scores.ethics is number && scores.ethics >= 0 && scores.ethics <= criteria[0].max &&
        scores.skills is number && scores.skills >= 0 && scores.skills <= criteria[1].max &&
        scores.innovation is number && scores.innovation >= 0 && scores.innovation <= criteria[2].max &&
        scores.quantity is number && scores.quantity >= 0 && scores.quantity <= criteria[3].max &&
        scores.quality is number && scores.quality >= 0 && scores.quality <= criteria[4].max &&
        scores.timeliness is number && scores.timeliness >= 0 && scores.timeliness <= criteria[5].max;
    }
    function kpiTotal(scores) {
      return scores.ethics + scores.skills + scores.innovation +
        scores.quantity + scores.quality + scores.timeliness;
    }
    function kpiEntryShape(uid, criteria) {
      let data = incoming();
      return data.keys().hasAll(['uid','name','team','selfScores','selfTotal','status',
          'reviewScores','reviewTotal','note','reviewedBy','approvedBy','createdAt','updatedAt']) &&
        data.keys().hasOnly(['uid','name','team','selfScores','selfTotal','status',
          'reviewScores','reviewTotal','note','reviewedBy','approvedBy','createdAt','updatedAt']) &&
        data.uid == uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.team is string && data.team.size() <= 120 &&
        data.note is string && data.note.size() <= 1500 &&
        data.reviewedBy is string && data.reviewedBy.size() <= 128 &&
        data.approvedBy is string && data.approvedBy.size() <= 128 &&
        data.createdAt is timestamp && data.updatedAt is timestamp &&
        data.status in ['draft','submitted','returned','reviewed','approved'] &&
        kpiScoresSafe(data.selfScores, criteria) &&
        data.selfTotal == kpiTotal(data.selfScores) &&
        ((data.reviewScores == null && data.reviewTotal == null) ||
         (kpiScoresSafe(data.reviewScores, criteria) &&
          data.reviewTotal == kpiTotal(data.reviewScores)));
    }
    function kpiPeriodOpen(schoolId, month) {
      return exists(kpiPeriodPath(schoolId, month)) &&
        get(kpiPeriodPath(schoolId, month)).data.status == 'open';
    }

    match /kpiSchools/{schoolId} {
      allow get: if kpiCanAccess(schoolId);
      allow list: if false;
      allow create: if (isActiveTeacher() || isAdmin()) &&
        incoming().keys().hasAll(['name','ownerUid','criteria','createdAt']) &&
        incoming().keys().hasOnly(['name','ownerUid','criteria','createdAt']) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 160 &&
        incoming().createdAt == request.time &&
        kpiCriteriaSafe(incoming().criteria);
      allow update: if kpiOwner(schoolId) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().keys().hasOnly(['name','ownerUid','criteria','createdAt']) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name','criteria']) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 160 &&
        kpiCriteriaSafe(incoming().criteria);
      allow delete: if false;

      match /members/{memberUid} {
        allow get: if isOwner(memberUid) || kpiReviewer(schoolId);
        allow list: if kpiReviewer(schoolId);
        allow create, update: if kpiOwner(schoolId) &&
          isValidId(memberUid) &&
          incoming().keys().hasAll(['uid','name','team','role','status']) &&
          incoming().keys().hasOnly(['uid','name','team','role','status']) &&
          incoming().uid == memberUid &&
          incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 160 &&
          incoming().team is string && incoming().team.size() <= 120 &&
          incoming().role in ['teacher','reviewer'] &&
          incoming().status == 'active' &&
          exists(/databases/$(database)/documents/teachers/$(memberUid)) &&
          get(/databases/$(database)/documents/teachers/$(memberUid)).data.status == 'active';
        allow delete: if kpiOwner(schoolId);
      }
      match /periods/{month} {
        allow read: if kpiCanAccess(schoolId);
        allow create: if kpiOwner(schoolId) &&
          month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$') &&
          incoming().keys().hasAll(['month','status','criteria','createdAt','updatedAt']) &&
          incoming().keys().hasOnly(['month','status','criteria','createdAt','updatedAt']) &&
          incoming().month == month && incoming().status == 'open' &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time &&
          kpiCriteriaSafe(incoming().criteria) &&
          incoming().criteria == get(kpiSchoolPath(schoolId)).data.criteria;
        allow update: if kpiOwner(schoolId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status','updatedAt']) &&
          incoming().month == existing().month &&
          incoming().criteria == existing().criteria &&
          incoming().createdAt == existing().createdAt &&
          incoming().status in ['open','closed'] &&
          incoming().status != existing().status &&
          incoming().updatedAt == request.time;
        allow delete: if false;

        match /entries/{employeeUid} {
          allow get: if (isOwner(employeeUid) && kpiCanAccess(schoolId)) || kpiReviewer(schoolId);
          allow list: if kpiReviewer(schoolId);
          allow create: if isOwner(employeeUid) && kpiActiveMember(schoolId) &&
            kpiPeriodOpen(schoolId, month) &&
            kpiEntryShape(employeeUid, get(kpiPeriodPath(schoolId, month)).data.criteria) &&
            incoming().createdAt == request.time && incoming().updatedAt == request.time &&
            incoming().status in ['draft','submitted'] &&
            incoming().reviewScores == null && incoming().reviewTotal == null &&
            incoming().note == '' && incoming().reviewedBy == '' && incoming().approvedBy == '';
          allow update: if kpiPeriodOpen(schoolId, month) &&
            kpiEntryShape(employeeUid, get(kpiPeriodPath(schoolId, month)).data.criteria) &&
            incoming().uid == existing().uid &&
            incoming().name == existing().name &&
            incoming().team == existing().team &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            (
              (isOwner(employeeUid) && kpiActiveMember(schoolId) &&
                existing().status in ['draft','returned'] &&
                incoming().status in ['draft','submitted'] &&
                incoming().diff(existing()).affectedKeys().hasOnly(['selfScores','selfTotal','status','updatedAt']))
              ||
              (kpiReviewer(schoolId) && !isOwner(employeeUid) &&
                existing().status in ['submitted','reviewed'] &&
                incoming().status in ['reviewed','returned'] &&
                incoming().reviewScores != null &&
                incoming().reviewTotal == kpiTotal(incoming().reviewScores) &&
                incoming().reviewedBy == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'reviewScores','reviewTotal','note','reviewedBy','status','updatedAt'
                ]))
              ||
              (kpiOwner(schoolId) && !isOwner(employeeUid) &&
                existing().status == 'reviewed' && incoming().status == 'approved' &&
                incoming().approvedBy == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status','approvedBy','updatedAt']))
            );
          allow delete: if false;
        }
      }
    }

  }
}
