# Optional private Node.js server only. Never expose this value in VITE_ variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.1-flash-lite"

# OpenAI for inline learning-wall chat/assessment. These are SERVER-ONLY settings.
# Supply secrets through the hosting service, never GitHub Pages or VITE_ variables.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
# Claude for the same private wall API. Supply this secret only on the server.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Comma-separated Firebase Authentication UIDs of explicitly authorized teachers.
# Empty means nobody can call the private proxy.
OPENAI_TEACHER_UIDS=""
# Optional verified Firebase Auth emails, as an alternative to exact teacher UIDs.
# An unverified email or anonymous account never authorizes API usage.
OPENAI_TEACHER_EMAILS=""
ALLOWED_ORIGINS="https://thiebithocsovn.github.io,http://localhost:3000,http://127.0.0.1:3000"
# On a private server, configure Firebase Admin ADC using a service-account file
# stored outside this repository, or the hosting service's managed credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/private/path/firebase-service-account.json

# Public deployment settings. No API key or authentication token belongs here.
VITE_WALL_AI_PROVIDER="openai"
# HTTPS origin of the deployed private Node server, without /api/wall-ai.
# Required for GitHub Pages; empty reports that OpenAI is not connected.
VITE_WALL_OPENAI_API_URL=""
# Optional different HTTPS API origin for Claude; otherwise uses the private API above.
VITE_WALL_ANTHROPIC_API_URL=""

# Public model name used by the Firebase AI Logic browser SDK.
VITE_GOOGLE_AI_MODEL="gemini-3.1-flash-lite"

# Public reCAPTCHA Enterprise site key for Firebase App Check.
# Register the website in Firebase App Check before setting this value.
VITE_FIREBASE_APP_CHECK_SITE_KEY=""

# Optional hosting path. GitHub Pages defaults to /4.0/; Cloudflare Pages defaults to /.
VITE_APP_BASE_PATH=""

# Shared school computers use memory-only Firestore storage by default.
# Set to persistent only on a trusted, single-teacher personal device.
VITE_FIRESTORE_CACHE_MODE="memory"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
